.model-popup-buttons{
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin: 20px 0 0;
}
.model-popup-btn{
  font-family: Raleway, sans-serif;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #54595f;
  background: none;
  border: 1px solid #54595f;
  padding: 10px 26px;
  cursor: pointer;
  transition: color .2s ease, border-color .2s ease;
}
.model-popup-btn:hover,
.model-popup-btn:focus-visible{
  color: #88bec1;
  border-color: #88bec1;
  outline: none;
}
.model-popup{
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 40px 20px;
}
.model-popup[hidden]{ display: none; }
.model-popup-inner{
  position: relative;
  width: 100%;
  max-width: 1000px;
  max-height: 90vh;
  overflow-y: auto;
  background: #fff;
  padding: 40px;
}
.model-popup-title{
  font-family: Raleway, sans-serif;
  font-size: 20px;
  font-weight: 400;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #54595f;
  text-align: center;
  margin: 0 0 24px;
}
.model-popup-gallery{
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
  min-height: 80px;
}
.model-popup-gallery img{
  width: 100%;
  height: auto;
  display: block;
}
.model-popup-gallery img:only-child{
  grid-column: 1 / -1;
}
.model-popup-download{
  display: block;
  width: fit-content;
  margin: 24px auto 0;
  font-family: Raleway, sans-serif;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #54595f;
  border: 1px solid #54595f;
  padding: 10px 24px;
  text-decoration: none;
  transition: color .2s ease, border-color .2s ease;
}
.model-popup-download:hover,
.model-popup-download:focus-visible{
  color: #88bec1;
  border-color: #88bec1;
  outline: none;
}
.model-popup-close{
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  color: #54595f;
  font-size: 2rem;
  line-height: 1;
  cursor: pointer;
}
.model-popup-close:hover{ color: #88bec1; }
@media (max-width: 600px){
  .model-popup-inner{ padding: 24px; }
}
</style>
{% include "partials/art-lightbox.html" %}

<script>
(function(){
  document.querySelectorAll(".model-popup-btn").forEach(function(btn){
    btn.addEventListener("click", function(){
      var popup = document.getElementById("model-popup-" + btn.getAttribute("data-popup"));
      if (popup) popup.hidden = false;
    });
  });
  document.querySelectorAll(".model-popup").forEach(function(popup){
    function hide(){ popup.hidden = true; }
    popup.querySelector(".model-popup-close").addEventListener("click", hide);
    popup.addEventListener("click", function(e){
      if (e.target === popup) hide();
    });
    document.addEventListener("keydown", function(e){
      if (!popup.hidden && e.key === "Escape") hide();
    });
  });
})();
</script>
